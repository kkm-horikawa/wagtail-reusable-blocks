#: apps.py:17
msgid "Wagtail Reusable Blocks"
msgstr "Wagtail ပြန်သုံးနိုင်သော ဘလော့များ"

#: blocks/chooser.py:107 models/reusable_block.py:89
msgid "Maximum nesting depth exceeded"
msgstr "အဆင့်ဆင့်ထပ်ဆင့်ထည့်သွင်းနိုင်သည့် အများဆုံးအဆင့် ကျော်လွန်သွားပါပြီ"

#: blocks/head_injection.py:69 models/reusable_block.py:46
msgid "Preview Head Injection"
msgstr "Head ထဲထည့်သွင်းမှု အစမ်းကြည့်ရှုခြင်း"

#: blocks/image.py:37 blocks/image.py:44
msgid "Image"
msgstr "ပုံ"

#: blocks/image.py:38
msgid "Select an image to display"
msgstr "ဖော်ပြလိုသည့် ပုံကို ရွေးချယ်ပါ"

#: blocks/image.py:45
msgid "Image with responsive format support"
msgstr "မျက်နှာပြင်အရွယ်အစားအလိုက် ပြောင်းလဲပေးနိုင်သော ပုံစနစ်"

#: blocks/layout.py:73
msgid "Select a layout template with slot placeholders"
msgstr "နေရာလွတ်များပါဝင်သော အပြင်အဆင် ပုံစံခွက်တစ်ခုကို ရွေးချယ်ပါ"

#: blocks/layout.py:91
msgid "Fill the slots in this layout template"
msgstr "ဤအပြင်အဆင် ပုံစံခွက်ရှိ နေရာလွတ်များကို ဖြည့်စွက်ပါ"

#: blocks/layout.py:100
msgid "Reusable Layout"
msgstr "ပြန်သုံးနိုင်သော အပြင်အဆင်"

#: blocks/layout.py:101
msgid "Layout template with customizable content slots"
msgstr "စိတ်ကြိုက်ပြင်ဆင်နိုင်သော အကြောင်းအရာနေရာလွတ်များပါသည့် အပြင်အဆင် ပုံစံခွက်"

#: blocks/slot_fill.py:96
msgid "The slot identifier to fill (e.g., 'main', 'sidebar')"
msgstr "ဖြည့်စွက်မည့် နေရာလွတ် သတ်မှတ်အမည် (ဥပမာ- 'main'၊ 'sidebar')"

#: blocks/slot_fill.py:97
msgid "Slot ID"
msgstr "နေရာလွတ် ID"

#: blocks/slot_fill.py:113
msgid "Content to inject into this slot"
msgstr "ဤနေရာလွတ်ထဲသို့ ထည့်သွင်းမည့် အကြောင်းအရာ"

#: blocks/slot_fill.py:114
msgid "Slot Content"
msgstr "နေရာလွတ် အကြောင်းအရာ"

#: blocks/slot_fill.py:123
msgid "Slot Fill"
msgstr "နေရာလွတ် ဖြည့်စွက်မှု"

#: blocks/slot_fill.py:124
msgid "Fill a specific slot with content"
msgstr "သတ်မှတ်ထားသော နေရာလွတ်ကို အကြောင်းအရာဖြင့် ဖြည့်စွက်ပါ"

#: models/reusable_block.py:106 models/reusable_block.py:244
msgid "Reusable Block"
msgstr "ပြန်သုံးနိုင်သော ဘလော့"

#: models/reusable_block.py:184
msgid "name"
msgstr "အမည်"

#: models/reusable_block.py:186
msgid "Human-readable name for this reusable block"
msgstr "ဤပြန်သုံးနိုင်သော ဘလော့အတွက် ဖတ်ရှုရလွယ်ကူသည့် အမည်"

#: models/reusable_block.py:189
msgid "slug"
msgstr "slug အမည်"

#: models/reusable_block.py:193
msgid "URL-safe identifier, auto-generated from name"
msgstr "အမည်မှ အလိုအလျောက်ထုတ်ပေးထားသော URL သတ်မှတ်အမည်"

#: models/reusable_block.py:204
msgid "content"
msgstr "အကြောင်းအရာ"

#: models/reusable_block.py:205
msgid "The content of this reusable block"
msgstr "ဤပြန်သုံးနိုင်သော ဘလော့၏ အကြောင်းအရာ"

#: models/reusable_block.py:245 wagtail_hooks.py:56
msgid "Reusable Blocks"
msgstr "ပြန်သုံးနိုင်သော ဘလော့များ"

#: models/reusable_block.py:300
#, python-format
msgid ""
"Circular reference detected: Block '%(name)s' (id=%(id)s) references itself "
"in the dependency chain."
msgstr ""
"အပြန်အလှန်ချိတ်ဆက်မှု လွဲမှားနေပါသည်- ဘလော့ '%(name)s' (id=%(id)s) သည် မိမိကိုယ်ကို ပြန်လည်ညွှန်းဆိုနေပါသည်။"

#: models/reusable_block.py:320
#, python-format
msgid ""
"Circular reference detected: Block '%(name)s' references block "
"'%(ref_name)s' which creates a cycle. %(error)s"
msgstr ""
"အပြန်အလှန်ချိတ်ဆက်မှု လွဲမှားနေပါသည်- ဘလော့ '%(name)s' သည် ဘလော့ '%(ref_name)s' ကို ညွှန်းဆိုထားသဖြင့် သံသရာလည်နေပါသည်။ %(error)s"